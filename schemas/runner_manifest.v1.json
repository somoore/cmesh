{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cmesh.local/runner_manifest.v1.json",
  "title": "cmesh runner capability manifest v1",
  "description": "Evidence-backed capability declaration for a runner and its profiles. Mirrors internal/runner/types.go (CapabilityManifest, ProfileManifest).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "runner_manifest.v1"
    },
    "runner": {
      "$ref": "#/$defs/runner_id"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Optional runner version string."
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/profile_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "enforcement_confidence"
      ],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability_claim"
          },
          "uniqueItems": true
        },
        "native_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "native_controls": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Named native controls reported by the runner adapter (string-to-string)."
        },
        "credential_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The credential route used by this profile, such as ANTHROPIC_API_KEY|apiKeyHelper, subscription_login, or a runner-specific login."
        },
        "billing": {
          "enum": ["api", "subscription", "local", "unknown", "codex account"]
        },
        "enforcement_confidence": {
          "enum": ["low", "medium", "high"]
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "mid_task_input": {
          "enum": ["none", "checkpoint", "stream"],
          "description": "How this runner receives messages sent to a task while it runs: none (cannot), checkpoint (agent picks up queued messages when it calls task_ask), or stream (harness accepts input on open stdin mid-run)."
        },
        "bare": {
          "type": "boolean"
        }
      }
    },
    "capability_claim": {
      "enum": [
        "read_files",
        "edit_repo",
        "execute_repo_commands",
        "network",
        "git_push",
        "subdelegate",
        "access_local_credentials",
        "use_mcp_tools"
      ]
    },
    "runner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9._-]+$"
    }
  }
}
