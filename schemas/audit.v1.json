{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cmesh.local/audit.v1.json",
  "title": "cmesh audit event v1",
  "description": "Append-only JSONL audit event. Designed for local inspection and AgentSnitch-style ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "event_type",
    "node",
    "task_id",
    "source",
    "origin",
    "peer",
    "provenance",
    "policy",
    "runner"
  ],
  "properties": {
    "schema_version": {
      "const": "audit.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "task.dispatch.requested",
        "task.dispatch.accepted",
        "task.dispatch.denied",
        "task.started",
        "task.completed",
        "task.failed",
        "task.cancelled",
        "policy.denied",
        "runner.spawned",
        "runner.exited",
        "result.created"
      ]
    },
    "node": {
      "$ref": "#/$defs/node"
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "source": {
      "enum": ["local_mcp", "mesh_rpc", "worker", "doctor", "cli"]
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "peer": {
      "$ref": "#/$defs/peer"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "git": {
      "$ref": "#/$defs/git"
    },
    "result": {
      "$ref": "#/$defs/result_summary"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_name"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "node_name": {
          "$ref": "#/$defs/node_name"
        },
        "tailscale_ip": {
          "type": "string",
          "format": "ipv4"
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_name", "session_id", "harness", "harness_version"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "node_name": {
          "$ref": "#/$defs/node_name"
        },
        "session_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "harness_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_name", "identity_source", "authenticated"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "node_name": {
          "$ref": "#/$defs/node_name"
        },
        "tailscale_user": {
          "type": "string",
          "maxLength": 255
        },
        "tailscale_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        },
        "identity_source": {
          "enum": ["tailscale_whois", "manual_shared_secret", "local"]
        },
        "authenticated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_sha256", "chain", "hop_count", "hop_limit"],
      "properties": {
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/chain_entry"
          }
        },
        "hop_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_name", "timestamp"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "node_name": {
          "$ref": "#/$defs/node_name"
        },
        "task_id": {
          "$ref": "#/$defs/task_id"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "checks"],
      "properties": {
        "decision": {
          "enum": ["allow", "deny", "not_applicable"]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_check"
          }
        },
        "profile_requested": {
          "$ref": "#/$defs/profile_name"
        },
        "profile_effective": {
          "$ref": "#/$defs/profile_name"
        },
        "requested_claims": {
          "$ref": "#/$defs/claims"
        },
        "granted_claims": {
          "$ref": "#/$defs/claims"
        },
        "used_claims": {
          "$ref": "#/$defs/claims"
        }
      }
    },
    "policy_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "profile", "controls"],
      "properties": {
        "runner": {
          "$ref": "#/$defs/runner_id"
        },
        "runner_version": {
          "type": "string",
          "maxLength": 120
        },
        "profile": {
          "$ref": "#/$defs/profile_name"
        },
        "controls": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "array", "object", "null"]
          }
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_root": {
          "type": "string",
          "maxLength": 4096
        },
        "branch": {
          "type": "string",
          "maxLength": 255
        },
        "base_commit": {
          "$ref": "#/$defs/git_sha"
        },
        "head_commit": {
          "$ref": "#/$defs/git_sha"
        },
        "pushed": {
          "type": "boolean"
        }
      }
    },
    "result_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["done", "failed", "denied", "cancelled"]
        },
        "result_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "verification_required": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "enum": [
          "read_files",
          "edit_repo",
          "execute_repo_commands",
          "network",
          "git_push",
          "subdelegate",
          "access_local_credentials",
          "use_mcp_tools"
        ]
      },
      "uniqueItems": true
    },
    "error_code": {
      "enum": [
        "peer_unreachable",
        "peer_unauthorized",
        "runner_unavailable",
        "profile_unavailable",
        "profile_denied",
        "cwd_denied",
        "dirty_worktree",
        "version_mismatch",
        "task_conflict",
        "timeout",
        "needs_human",
        "worker_failed",
        "worker_daemon_restarted",
        "cancelled",
        "result_too_large",
        "transcript_unavailable"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "node_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "node_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "runner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  }
}
